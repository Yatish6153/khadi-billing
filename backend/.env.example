# Copy this file to .env and fill in real values.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string (local Docker, Supabase, Railway, Neon ...)
DATABASE_URL="postgresql://khadi:khadi@localhost:5432/khadi_billing?schema=public"

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# How long a login stays valid, in hours
SESSION_HOURS=12

# Origin of the Next.js frontend (used for CORS)
FRONTEND_URL=http://localhost:3000

# First admin account, created by `npm run db:seed` (only if it doesn't exist yet).
# Change the password after the first login.
ADMIN_NAME="Shop Admin"
ADMIN_EMAIL=admin@khadishop.in
ADMIN_PASSWORD=ChangeMe123
