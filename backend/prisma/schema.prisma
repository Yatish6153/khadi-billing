// =====================================================================
// Khadi GST Billing — database schema
// All money values use Decimal(12,2); quantities use Decimal(12,3) so
// fabric can be sold by the metre (e.g. 2.750 MTR).
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------

enum Role {
  ADMIN
  STAFF
}

enum Unit {
  PCS
  MTR
  FT
  KG
  GM
  LTR
  SET
  PAIR
  BOX
}

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CREDIT
}

enum InvoiceStatus {
  PAID
  UNPAID
  PARTIAL
  CANCELLED
}

enum StockMovementType {
  OPENING
  PURCHASE
  SALE
  SALE_REVERSAL
  ADJUSTMENT
}

// ---------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(ADMIN)
  isActive     Boolean   @default(true)
  /// Bumped on password change so every previously issued JWT stops working.
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  invoices Invoice[]

  @@map("users")
}

// ---------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  mobile    String?
  email     String?
  gstNumber String?
  address   String?
  city      String?
  state     String?
  /// 2-digit GST state code (e.g. "27" for Maharashtra). Drives CGST/SGST vs IGST.
  stateCode String?
  pincode   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@index([name])
  @@index([mobile])
  @@map("customers")
}

// ---------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id                Int      @id @default(autoincrement())
  name              String
  sku               String   @unique
  barcode           String?  @unique
  categoryId        Int?
  hsnCode           String?
  gstRate           Decimal  @default(0) @db.Decimal(5, 2)
  purchasePrice     Decimal  @default(0) @db.Decimal(12, 2)
  sellingPrice      Decimal  @db.Decimal(12, 2)
  /// true = selling price is MRP inclusive of GST (typical for retail counters).
  taxInclusive      Boolean  @default(true)
  unit              Unit     @default(PCS)
  /// false = stock is not counted for this item (no stock changes, no low-stock alerts).
  /// The shop bills most items without tracking stock, so this is off by default.
  trackStock        Boolean  @default(false)
  stockQuantity     Decimal  @default(0) @db.Decimal(12, 3)
  lowStockThreshold Decimal  @default(5) @db.Decimal(12, 3)
  imageUrl          String?
  /// Products are never hard-deleted once billed; they are deactivated instead.
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  invoiceItems   InvoiceItem[]
  stockMovements StockMovement[]

  @@index([name])
  @@index([categoryId])
  @@map("products")
}

// ---------------------------------------------------------------------
// Invoices
// ---------------------------------------------------------------------

model Invoice {
  id            Int      @id @default(autoincrement())
  invoiceNumber String   @unique
  invoiceDate   DateTime @default(now())
  customerId    Int?

  // Snapshot of the customer at billing time, so later edits to the
  // customer record never alter an already-issued tax invoice.
  customerName      String
  customerMobile    String?
  customerGstin     String?
  customerAddress   String?
  customerState     String?
  customerStateCode String?

  placeOfSupply String?
  isInterState  Boolean @default(false)

  subtotal            Decimal @db.Decimal(12, 2)
  /// Whole-bill discount, printed as e.g. "50% Less" under the item table.
  billDiscountPercent Decimal @default(0) @db.Decimal(5, 2)
  /// Line discounts + bill discount, in rupees.
  discountTotal       Decimal @default(0) @db.Decimal(12, 2)
  taxableAmount Decimal @db.Decimal(12, 2)
  cgstTotal     Decimal @default(0) @db.Decimal(12, 2)
  sgstTotal     Decimal @default(0) @db.Decimal(12, 2)
  igstTotal     Decimal @default(0) @db.Decimal(12, 2)
  roundOff      Decimal @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal @db.Decimal(12, 2)
  amountInWords String

  paymentMode PaymentMode   @default(CASH)
  status      InvoiceStatus @default(PAID)
  notes       String?

  createdById Int?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer  Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     InvoiceItem[]

  @@index([invoiceDate])
  @@index([customerId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id        Int  @id @default(autoincrement())
  invoiceId Int
  productId Int?

  // Product snapshot
  productName String
  sku         String?
  hsnCode     String?
  unit        Unit    @default(PCS)

  /// नग — number of pieces handed over (printed, not used in the amount).
  pieces          Int     @default(1)
  /// Billed quantity: metres/feet for fabric (मीटर/Ft.), otherwise pieces.
  /// Amount (रकम) = quantity × rate.
  quantity        Decimal @db.Decimal(12, 3)
  rate            Decimal @db.Decimal(12, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal @default(0) @db.Decimal(12, 2)
  taxableValue    Decimal @db.Decimal(12, 2)
  gstRate         Decimal @db.Decimal(5, 2)
  cgstAmount      Decimal @default(0) @db.Decimal(12, 2)
  sgstAmount      Decimal @default(0) @db.Decimal(12, 2)
  igstAmount      Decimal @default(0) @db.Decimal(12, 2)
  lineTotal       Decimal @db.Decimal(12, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

// ---------------------------------------------------------------------
// Inventory ledger — every stock change is recorded for the stock report.
// ---------------------------------------------------------------------

model StockMovement {
  id           Int               @id @default(autoincrement())
  productId    Int
  type         StockMovementType
  /// Signed: negative for sales, positive for purchases / reversals.
  quantity     Decimal           @db.Decimal(12, 3)
  balanceAfter Decimal           @db.Decimal(12, 3)
  invoiceId    Int?
  reference    String?
  note         String?
  createdAt    DateTime          @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------
// Shop settings — single row (id = 1)
// ---------------------------------------------------------------------

model Setting {
  id                 Int     @id @default(1)
  shopName           String  @default("My Khadi Bhandar")
  tagline            String?
  address            String?
  city               String?
  state              String?
  stateCode          String?
  pincode            String?
  phone              String?
  alternatePhone     String?
  email              String?
  gstNumber          String?
  logoUrl            String?
  signatureUrl       String?
  /// Empty = plain serial numbers (क्रमांक 2156), matching the paper bill book.
  invoicePrefix      String  @default("")
  /// Set this to continue numbering from the existing bill book.
  nextInvoiceNumber  Int     @default(1)
  invoiceFooter      String?
  /// One condition per line, printed as bullets at the bottom of the bill.
  termsAndConditions String? @default("बिका हुआ माल वापिस नहीं लिया जायेगा\nभूल चुक लेनी देनी")
  bankName           String?
  bankAccountNumber  String?
  bankIfsc           String?
  /// Used to render the payment QR code on invoices.
  upiId              String?
  /// Pre-filled "% Less" on every new bill (the shop gives 50% on all bills).
  defaultDiscountPercent Decimal @default(50) @db.Decimal(5, 2)
  /// GST rate assumed for typed-in items that aren't linked to a product (prices include GST).
  defaultGstRate         Decimal @default(5) @db.Decimal(5, 2)
  autoBackupEnabled  Boolean   @default(true)
  lastBackupAt       DateTime?
  updatedAt          DateTime  @updatedAt

  @@map("settings")
}
